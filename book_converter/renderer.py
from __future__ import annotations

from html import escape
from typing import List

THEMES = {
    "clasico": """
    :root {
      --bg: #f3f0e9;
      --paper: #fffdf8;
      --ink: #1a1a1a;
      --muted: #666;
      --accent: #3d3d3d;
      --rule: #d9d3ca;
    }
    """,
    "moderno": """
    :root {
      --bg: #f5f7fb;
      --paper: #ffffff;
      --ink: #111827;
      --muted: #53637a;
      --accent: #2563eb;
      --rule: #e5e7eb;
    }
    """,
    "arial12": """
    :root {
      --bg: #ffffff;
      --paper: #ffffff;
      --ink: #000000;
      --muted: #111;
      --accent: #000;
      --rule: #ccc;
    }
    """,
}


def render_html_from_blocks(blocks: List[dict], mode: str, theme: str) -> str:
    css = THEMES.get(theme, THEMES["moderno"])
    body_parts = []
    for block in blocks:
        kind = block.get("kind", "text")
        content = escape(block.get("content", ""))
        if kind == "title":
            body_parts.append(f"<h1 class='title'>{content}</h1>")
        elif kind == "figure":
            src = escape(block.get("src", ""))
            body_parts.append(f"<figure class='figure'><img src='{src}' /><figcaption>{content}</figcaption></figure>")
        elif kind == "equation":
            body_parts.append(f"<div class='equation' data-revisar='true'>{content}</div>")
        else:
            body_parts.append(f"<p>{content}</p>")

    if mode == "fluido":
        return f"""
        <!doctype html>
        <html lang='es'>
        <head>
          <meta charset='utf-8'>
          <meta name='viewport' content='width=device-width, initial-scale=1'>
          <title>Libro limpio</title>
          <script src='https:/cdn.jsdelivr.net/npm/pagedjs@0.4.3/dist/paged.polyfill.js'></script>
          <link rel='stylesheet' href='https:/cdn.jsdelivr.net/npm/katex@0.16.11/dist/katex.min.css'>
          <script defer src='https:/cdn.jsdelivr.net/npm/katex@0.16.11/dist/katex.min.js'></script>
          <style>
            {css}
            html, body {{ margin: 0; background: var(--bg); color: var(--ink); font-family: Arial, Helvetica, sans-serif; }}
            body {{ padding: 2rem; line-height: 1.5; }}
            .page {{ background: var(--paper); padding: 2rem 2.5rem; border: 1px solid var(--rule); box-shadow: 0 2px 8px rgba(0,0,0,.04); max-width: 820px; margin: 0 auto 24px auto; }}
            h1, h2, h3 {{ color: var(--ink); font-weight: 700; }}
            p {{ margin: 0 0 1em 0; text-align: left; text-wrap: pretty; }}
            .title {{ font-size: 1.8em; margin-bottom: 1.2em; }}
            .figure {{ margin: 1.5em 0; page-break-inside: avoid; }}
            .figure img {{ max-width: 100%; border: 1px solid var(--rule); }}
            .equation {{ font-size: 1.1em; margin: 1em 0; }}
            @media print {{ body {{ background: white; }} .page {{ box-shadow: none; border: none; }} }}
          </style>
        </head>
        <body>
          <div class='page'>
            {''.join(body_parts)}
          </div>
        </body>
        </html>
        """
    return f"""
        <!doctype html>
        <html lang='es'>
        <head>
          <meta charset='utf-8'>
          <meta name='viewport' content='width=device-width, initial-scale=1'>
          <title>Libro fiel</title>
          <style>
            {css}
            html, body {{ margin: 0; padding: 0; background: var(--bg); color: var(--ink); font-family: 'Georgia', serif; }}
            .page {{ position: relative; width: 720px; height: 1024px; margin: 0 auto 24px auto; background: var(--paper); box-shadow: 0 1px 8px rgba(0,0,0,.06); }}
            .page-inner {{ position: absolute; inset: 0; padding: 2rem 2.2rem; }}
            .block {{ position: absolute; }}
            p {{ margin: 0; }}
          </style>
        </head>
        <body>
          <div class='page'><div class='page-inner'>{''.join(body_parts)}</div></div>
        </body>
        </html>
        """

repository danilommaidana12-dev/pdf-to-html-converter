from __future__ import annotations

import re
from typing import List, Tuple

from .models import LayoutBlock, TextSpan


def detect_pdf_type(page_text_len: int, page_image_ratio: float = 0.0) -> str:
    if page_text_len > 400:
        return "digital"
    if page_image_ratio > 0.25:
        return "scanned"
    return "digital" if page_text_len > 120 else "scanned"


def normalize_text(value: str) -> str:
    return re.sub(r"\s+", " ", value or "").strip()


def find_vertical_gaps(spans: List[TextSpan], page_width: float) -> List[Tuple[float, float]]:
    if not spans:
        return [(0.0, page_width)]
    buckets = [(x, x + 5) for x in range(0, int(page_width) + 1, 5)]
    gaps = []
    for x0, x1 in buckets:
        count = 0
        for s in spans:
            if s.x0 < x1 and s.x1 > x0:
                count += 1
        if count == 0:
            gaps.append((float(x0), float(x1)))
    return gaps


def detect_columns(spans: List[TextSpan], page_width: float, page_height: float) -> List[Tuple[float, float]]:
    gaps = find_vertical_gaps(spans, page_width)
    if not gaps:
        return [(0.0, page_width)]

    significant = []
    for x0, x1 in gaps:
        if (x1 - x0) / max(page_width, 1.0) > 0.06:
            significant.append((x0, x1))

    if not significant:
        return [(0.0, page_width)]

    merged = []
    for left, right in sorted(significant):
        if not merged or left > merged[-1][1]:
            merged.append([left, right])
        else:
            merged[-1][1] = max(merged[-1][1], right)

    columns = []
    cursor = 0.0
    for left, right in merged:
        if left > cursor:
            columns.append((cursor, left))
        cursor = max(cursor, right)
    if cursor < page_width:
        columns.append((cursor, page_width))
    return columns if columns else [(0.0, page_width)]


def merge_paragraphs(spans: List[TextSpan], vertical_gap: float = 12.0) -> List[List[TextSpan]]:
    if not spans:
        return []

    ordered = sorted(spans, key=lambda s: (-s.y0, s.x0))
    groups: List[List[TextSpan]] = []
    current: List[TextSpan] = []
    prev_y = None
    for s in ordered:
        if current:
            y_delta = abs(s.y0 - prev_y) if prev_y is not None else 0
            if y_delta > vertical_gap:
                groups.append(current)
                current = []
        current.append(s)
        prev_y = s.y0
    if current:
        groups.append(current)
    return groups


def split_hyphenated_words(text: str) -> str:
    text = re.sub(r"(?<=\w)-\s*\n\s*(?=\w)", "", text)
    text = re.sub(r"(?<=\w)-\s+(?=\w)", "", text)
    return text


def detect_figure_captions(spans: List[TextSpan]) -> List[str]:
    captions = []
    for s in spans:
        txt = normalize_text(s.text)
        if re.search(r"(Figura|Figure)\s+\d+", txt, flags=re.I):
            captions.append(txt)
    return captions


def rebuild_borderless_table(words: List[str], rows_estimate: int = 0) -> List[List[str]]:
    if not words:
        return []
    ncols = min(4, max(2, len(words) // 10))
    if rows_estimate > 0:
        ncols = max(ncols, min(5, int(rows_estimate * 0.75)))

    rows: List[List[str]] = []
    chunk: List[str] = []
    for idx, word in enumerate(words):
        chunk.append(word)
        if (idx + 1) % max(1, len(words) // max(1, ncols)) == 0:
            rows.append(chunk)
            chunk = []
    if chunk:
        rows.append(chunk)
    return rows


def order_blocks_for_reading(blocks: List[LayoutBlock]) -> List[LayoutBlock]:
    if not blocks:
        return []

    def sort_key(block: LayoutBlock):
        x0, y0, x1, y1 = block.rect
        width = x1 - x0
        height = y1 - y0
        score = 0
        if block.kind == "title":
            score -= 1000
        elif block.kind == "table":
            score += 200
        elif block.kind == "figure":
            score += 300
        return (y0, x0 + score, -width, -height)

    return sorted(blocks, key=sort_key)
